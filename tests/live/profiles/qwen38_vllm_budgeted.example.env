# Unified Context V2 admission envelope.  These are finite provisional
# ceilings for offline calibration; a live run must still pass the per-project
# archive/workset/plan admission before any model request.
export CODE2PAPER_MODEL_CONTEXT_TOKENS=131072
export CODE2PAPER_UNIFIED_MAX_PAGE_INPUT_TOKENS=20000
# Current-schema page projection: 590,543 Formalizer reservation + 1,197,594
# Writer reservation + 610,943 Realizer primary reservation, with 400,000
# Writer and 250,000 Realizer bounded-repair headroom.  The Realizer reserve
# reflects the measured r20 incumbent-preserving repair spend (104,138 tokens)
# while leaving finite room for later primary pages.  This is a provisional
# planning envelope only: send-time model-tokenizer accounting, provider usage
# reconciliation, and future-primary protection remain authoritative; a full
# Candidate run must not be treated as production-ready from this profile.

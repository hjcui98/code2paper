# Local-only Code2Paper live profile for the MTP-enabled Gemma 4 vLLM service.
# Source this file before explicit live tests. It contains no real secret.

export CODE2PAPER_LLM_PROVIDER=openai
export CODE2PAPER_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
export CODE2PAPER_LLM_MODEL=gemma4-31b-nvfp4
export CODE2PAPER_DEFAULT_LLM_MODEL=gemma4-31b-nvfp4
export OPENAI_API_KEY="${OPENAI_API_KEY:-dummy-local-vllm}"

export CODE2PAPER_LLM_CACHE=0
# These two globals are protocol sentinels. Role-tagged calls below replace
# them before a request is sent; 12000 is not a formal per-call budget.
export CODE2PAPER_LLM_TEMPERATURE=0
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS=12000
export CODE2PAPER_LLM_TEMPERATURE_INTENT_COMPILER=0.20
export CODE2PAPER_LLM_TEMPERATURE_CODE_INTAKE=0.20
export CODE2PAPER_LLM_TEMPERATURE_CODE_ANALYZER=0.20
export CODE2PAPER_LLM_TEMPERATURE_RESEARCH_SUPERVISOR=0.20
export CODE2PAPER_LLM_TEMPERATURE_AUTHORING_PLANNER=0.40
export CODE2PAPER_LLM_TEMPERATURE_METHOD_WRITER=0.70
export CODE2PAPER_LLM_TEMPERATURE_LOCAL_REWRITE=0.35
export CODE2PAPER_LLM_TEMPERATURE_SEMANTIC_VERIFIER=0.00
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_INTENT_COMPILER=4096
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_CODE_INTAKE=2048
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_CODE_ANALYZER=4096
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_RESEARCH_SUPERVISOR=1536
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_AUTHORING_PLANNER=2048
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_WRITER=8192
# Used only after a writer response ends with finish_reason=length.
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_WRITER_EXTENDED=12288
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_LOCAL_REWRITE=3072
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_SEMANTIC_VERIFIER=1024
export CODE2PAPER_LLM_TOP_P_METHOD_WRITER=0.95
export CODE2PAPER_LLM_TOP_K_METHOD_WRITER=50
export CODE2PAPER_LLM_TOP_P_RESEARCH_SUPERVISOR=0.90
export CODE2PAPER_LLM_TOP_K_RESEARCH_SUPERVISOR=40
export CODE2PAPER_LLM_TIMEOUT_SECONDS=300
export CODE2PAPER_LLM_RETRY_MAX_ATTEMPTS=2
export CODE2PAPER_RUN_LIVE_LLM=1
export CODE2PAPER_LIVE_PROFILE=gemma4_mtp_vllm

# Deployment expectations for the planned M0 live harness. The current
# LLMClient does not send these values in chat/completions payloads; MTP is
# configured server-side by vLLM.
export CODE2PAPER_EXPECT_INFERENCE_MODE=mtp
export CODE2PAPER_EXPECT_DEVICE_IDS=0,1
export CODE2PAPER_EXPECT_TP_SIZE=2
export CODE2PAPER_EXPECT_NUM_SPECULATIVE_TOKENS=1
export CODE2PAPER_EXPECT_DRAFT_TP_SIZE=2
export CODE2PAPER_EXPECT_MTP_ASSISTANT=/data1/users/cuihengjia/models/Gemma-4-31B-it-assistant

# Unified Context V2 admission envelope.  These are finite provisional
# ceilings for offline calibration; a live run must still pass the per-project
# archive/workset/plan admission before any model request.
export CODE2PAPER_MODEL_CONTEXT_TOKENS=131072
export CODE2PAPER_UNIFIED_MAX_PAGE_INPUT_TOKENS=20000
export CODE2PAPER_UNIFIED_MAX_TOTAL_INPUT_TOKENS=2000000
export CODE2PAPER_UNIFIED_MAX_FORMALIZER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_WRITER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_REALIZER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_OBLIGATIONS_PER_PAGE=8
export CODE2PAPER_UNIFIED_MAX_FORMULA_REPAIR_CALLS=32
export CODE2PAPER_UNIFIED_MAX_BINDER_CALLS=0
export CODE2PAPER_UNIFIED_SAFETY_MARGIN_TOKENS=1024
export CODE2PAPER_UNIFIED_PROMPT_TOKEN_RESERVE=2048
export CODE2PAPER_UNIFIED_THINKING_TOKEN_RESERVE=0
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_FORMALIZER=4096
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_WRITER=8192
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_REALIZER=8192
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_BINDER=2048
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_FORMALIZER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_WRITER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_REALIZER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_BINDER=20000
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_FORMALIZER=0
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_WRITER=4096
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_REALIZER=4096
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_BINDER=0

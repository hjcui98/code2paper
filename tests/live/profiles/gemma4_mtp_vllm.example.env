# Local-only Code2Paper live profile for the MTP-enabled Gemma 4 vLLM service.
# Source this file before explicit live tests. It contains no real secret.

export CODE2PAPER_LLM_PROVIDER=openai
export CODE2PAPER_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
export CODE2PAPER_LLM_MODEL=gemma4-31b-nvfp4
export CODE2PAPER_DEFAULT_LLM_MODEL=gemma4-31b-nvfp4
export OPENAI_API_KEY="${OPENAI_API_KEY:-dummy-local-vllm}"

export CODE2PAPER_LLM_CACHE=0
export CODE2PAPER_LLM_TEMPERATURE=0
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS=4096
export CODE2PAPER_LLM_TIMEOUT_SECONDS=300
export CODE2PAPER_LLM_RETRY_MAX_ATTEMPTS=2
export CODE2PAPER_RUN_LIVE_LLM=1
export CODE2PAPER_LIVE_PROFILE=gemma4_mtp_vllm

# Deployment expectations for the planned M0 live harness. The current
# LLMClient does not send these values in chat/completions payloads; MTP is
# configured server-side by vLLM.
export CODE2PAPER_EXPECT_INFERENCE_MODE=mtp
export CODE2PAPER_EXPECT_DEVICE_IDS=0,1
export CODE2PAPER_EXPECT_TP_SIZE=2
export CODE2PAPER_EXPECT_NUM_SPECULATIVE_TOKENS=1
export CODE2PAPER_EXPECT_DRAFT_TP_SIZE=2
export CODE2PAPER_EXPECT_MTP_ASSISTANT=/data1/users/cuihengjia/models/Gemma-4-31B-it-assistant

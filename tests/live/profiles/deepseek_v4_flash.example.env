# Code2Paper live profile for the deepseek-v4-flash OpenAI-compatible gateway
# (https://opencode.ai/zen/go/v1).  It contains no real secret: the API key is
# taken from OPENCODE_API_KEY and must be exported as OPENAI_API_KEY before the
# run (the profile loader deliberately skips shell-expansion values, so no
# ``$``-style references may appear in this file).

export CODE2PAPER_LLM_PROVIDER=openai
export CODE2PAPER_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
export CODE2PAPER_LLM_MODEL=deepseek-v4-flash
export CODE2PAPER_DEFAULT_LLM_MODEL=deepseek-v4-flash
export CODE2PAPER_LLM_CAPABILITY_PROFILE=tests/live/profiles/deepseek_v4_flash_capabilities.json

export CODE2PAPER_LLM_PUBLICATION_WRITER_RESPONSE_MODE=json_object
export CODE2PAPER_LLM_PUBLICATION_EDITOR_RESPONSE_MODE=json_object

export CODE2PAPER_LLM_CACHE=0
export CODE2PAPER_LLM_TEMPERATURE=0.6
export CODE2PAPER_LLM_TOP_P=0.95
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS=16384
export CODE2PAPER_LLM_TIMEOUT_SECONDS=1800
export CODE2PAPER_LLM_RETRY_MAX_ATTEMPTS=2

export CODE2PAPER_RUN_LIVE_LLM=1
export CODE2PAPER_LIVE_PROFILE=deepseek_v4_flash

# Not set on purpose (gateway compatibility):
# - CODE2PAPER_LLM_TOP_K           (ignored by the gateway; keep the request clean)
# - CODE2PAPER_LLM_REASONING_EFFORT (v4-flash manages its own reasoning)
# - CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_* (gateway returns empty content when sent)
# - CODE2PAPER_LLM_STREAM_STRUCTURED (streaming is only used on loopback endpoints)

# Unified Context V2 admission envelope.  These are finite provisional
# ceilings for offline calibration; a live run must still pass the per-project
# archive/workset/plan admission before any model request.
export CODE2PAPER_MODEL_CONTEXT_TOKENS=131072
export CODE2PAPER_UNIFIED_MAX_PAGE_INPUT_TOKENS=20000
export CODE2PAPER_UNIFIED_MAX_TOTAL_INPUT_TOKENS=2000000
export CODE2PAPER_UNIFIED_MAX_FORMALIZER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_WRITER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_REALIZER_CALLS=256
export CODE2PAPER_UNIFIED_MAX_OBLIGATIONS_PER_PAGE=8
export CODE2PAPER_UNIFIED_MAX_FORMULA_REPAIR_CALLS=32
export CODE2PAPER_UNIFIED_MAX_BINDER_CALLS=0
export CODE2PAPER_UNIFIED_SAFETY_MARGIN_TOKENS=1024
export CODE2PAPER_UNIFIED_PROMPT_TOKEN_RESERVE=2048
export CODE2PAPER_UNIFIED_THINKING_TOKEN_RESERVE=0
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_FORMALIZER=4096
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_WRITER=8192
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_REALIZER=8192
export CODE2PAPER_UNIFIED_OUTPUT_TOKEN_RESERVE_BINDER=2048
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_FORMALIZER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_WRITER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_REALIZER=60000
export CODE2PAPER_UNIFIED_MAX_REQUEST_INPUT_TOKENS_BINDER=20000
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_FORMALIZER=0
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_WRITER=4096
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_REALIZER=4096
export CODE2PAPER_UNIFIED_SCAFFOLDING_TOKEN_RESERVE_BINDER=0

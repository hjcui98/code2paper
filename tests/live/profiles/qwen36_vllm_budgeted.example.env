# Local Code2Paper live profile for Qwen3.6 served through vLLM's
# OpenAI-compatible API. It contains no real secret.

_CODE2PAPER_PROFILE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export CODE2PAPER_LLM_PROVIDER=openai
export CODE2PAPER_OPENAI_BASE_URL=http://127.0.0.1:8003/v1
export CODE2PAPER_LLM_MODEL=qwen36-27b-nvfp4
export CODE2PAPER_DEFAULT_LLM_MODEL=qwen36-27b-nvfp4
export OPENAI_API_KEY="${OPENAI_API_KEY:-dummy-local-vllm}"
export CODE2PAPER_LLM_CAPABILITY_PROFILE="${_CODE2PAPER_PROFILE_DIR}/qwen36_vllm_budgeted_capabilities.json"

export CODE2PAPER_LLM_CACHE=0
export CODE2PAPER_LLM_STREAM_STRUCTURED=1
export CODE2PAPER_LLM_PUBLICATION_WRITER_RESPONSE_MODE=native_json_schema
export CODE2PAPER_LLM_PUBLICATION_EDITOR_RESPONSE_MODE=native_json_schema
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_PUBLICATION_EDITOR=4096
export CODE2PAPER_LLM_TEMPERATURE=0.6
export CODE2PAPER_LLM_TOP_P=0.95
export CODE2PAPER_LLM_TOP_K=20
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS=16384
export CODE2PAPER_LLM_REASONING_EFFORT=low

# Bounded thinking: vLLM forces </think> at the per-request limit and then
# continues generating the answer within the role's max_output_tokens.
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_INTENT_COMPILER=1024
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_CODE_INTAKE=512
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_CODE_ANALYZER=1024
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_RESEARCH_SUPERVISOR=512
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_AUTHORING_PLANNER=512
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_METHOD_PROPOSITION_ARCHITECT=384
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_METHOD_WRITER=1024
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_LOCAL_REWRITE=512
export CODE2PAPER_LLM_THINKING_TOKEN_BUDGET_SEMANTIC_VERIFIER=256

export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_INTENT_COMPILER=16384
# Corrective Intent calls keep the same 1024-token thinking budget but have
# a wide answer allowance within the model's 131072-token context. The
# harness still extracts the first complete document when repetition reaches
# this safety ceiling.
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_INTENT_REPAIR=16384
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_CODE_INTAKE=2048
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_CODE_ANALYZER=4096
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_RESEARCH_SUPERVISOR=4096
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_AUTHORING_PLANNER=2048
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_PROPOSITION_ARCHITECT=3072
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_MECHANISM_DRAFT_PLANNER=8192
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_WRITER=8192
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_METHOD_WRITER_EXTENDED=12288
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_LOCAL_REWRITE=3072
export CODE2PAPER_LLM_MAX_OUTPUT_TOKENS_SEMANTIC_VERIFIER=1024

# vLLM's non-streaming OpenAI endpoint may not deliver response bytes until a
# wide answer is complete.  A 16K answer can legitimately take longer than
# five minutes on a single local GPU; using 300 seconds here causes the client
# to abandon healthy generations and submit the same expensive request again.
# Keep the transport timeout wide enough for the configured output ceiling.
# Semantic/format repair remains bounded separately by the owning Agent's
# attempt budget.
export CODE2PAPER_LLM_TIMEOUT_SECONDS=1800
export CODE2PAPER_LLM_RETRY_MAX_ATTEMPTS=2
export CODE2PAPER_RUN_LIVE_LLM=1
export CODE2PAPER_LIVE_PROFILE=qwen36_vllm_budgeted

# Deployment telemetry plus the profile-frozen R8 topology expectation.  The
# acceptance checker compares the recorded deployment against these values;
# this profile is intentionally TP=1 on one GPU rather than Gemma's legacy TP=2.
export CODE2PAPER_TP_SIZE=1
export CODE2PAPER_NUM_GPUS=1
export CODE2PAPER_R8_EXPECT_TP_SIZE=1
export CODE2PAPER_R8_EXPECT_NUM_GPUS=1
export CODE2PAPER_PARALLEL_PROJECTS=1

unset _CODE2PAPER_PROFILE_DIR

{
  "name": "@code2paper/dsh-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Code2Paper DSH bundle: host bridge service and model-facing tool rows. Development package; not published.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/task-tools.d.ts",
      "default": "./lib/task-tools.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/code2paper.patch.yml"
      ]
    }
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "package.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "toolchain:install": "node dev/toolchain/toolchain.mjs install",
    "toolchain:activate": "node dev/toolchain/toolchain.mjs activate",
    "toolchain:verify": "node dev/toolchain/toolchain.mjs verify",
    "typecheck": "node dev/toolchain/toolchain.mjs typecheck",
    "build": "node dev/toolchain/toolchain.mjs build",
    "stage": "node dev/toolchain/toolchain.mjs stage",
    "test:compat": "node dev/toolchain/toolchain.mjs test",
    "check:compat": "node dev/toolchain/toolchain.mjs check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "typescript": "5.9.3"
  }
}

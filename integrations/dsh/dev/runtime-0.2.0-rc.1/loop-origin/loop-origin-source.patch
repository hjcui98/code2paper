+/**
+ * Runtime-private dispatch origin for the agent loop's own model dispatches
+ * (loop-origin.1 c2p patch on dsh-v0.2.0-rc.1, commit 4878cdabd87d4041bdaff61d04c966883b9fd07a).
+ *
+ * AgentLoop establishes each origin and holds its private capability through
+ * stream consumption. peekLoopDispatchOrigin exposes a frozen session/signal
+ * snapshot. admitLoopDispatchOrigin is exported but requires the exact private
+ * capability by object identity before it may consume the one-shot admission.
+ * runOutsideLoopDispatchOrigin clears the scope for public-equivalent calls.
+ * There is no exported entry acknowledgement or take operation. Establishment
+ * remains internal to agent.ts; the protected module-level dispatch consumes
+ * admission only after capability validation.
+ */
+import { AsyncLocalStorage } from 'node:async_hooks'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+
+export interface LoopDispatchOrigin {
+  readonly sessionId: SessionId
+  readonly signal: AbortSignal
+  readonly request: unknown
+  capability: unknown
+  admitted: boolean
+}
+
+/** Frozen read-only view of a live origin. */
+export interface LoopDispatchOriginSnapshot {
+  readonly sessionId: SessionId
+  readonly signal: AbortSignal
+}
+
+const dispatchOrigin = new AsyncLocalStorage<LoopDispatchOrigin | undefined>()
+
+/** Establish the origin scope for one step's whole stream consumption. The
+ * returned capability is the live scope object itself: the loop passes it as
+ * an argument in its own call frame, and the capability-gated admission on
+ * the dispatch entry verifies it by object identity. Never exported. */
+export function establishLoopDispatchOrigin(
+  origin: Omit<LoopDispatchOrigin, 'capability' | 'admitted'>,
+): { run<T>(fn: () => T): T; capability: unknown } {
+  const full: LoopDispatchOrigin = { ...origin, capability: origin as unknown, admitted: false }
+  return {
+    run<T>(fn: () => T): T {
+      return dispatchOrigin.run(full, fn)
+    },
+    capability: full,
+  }
+}
+
+/**
+ * Frozen read-only snapshot; `undefined` outside a live dispatch scope. The
+ * snapshot deliberately excludes the request object and any mutable state:
+ * the same snapshot or request reference must not be able to preempt the
+ * legal dispatch.
+ */
+export function peekLoopDispatchOrigin(): LoopDispatchOriginSnapshot | undefined {
+  const origin = dispatchOrigin.getStore()
+  return origin === undefined
+    ? undefined
+    : Object.freeze({
+        sessionId: origin.sessionId,
+        signal: origin.signal,
+      })
+}
+
+/**
+ * Admit one stream entry as the loop's own. The capability is the live origin
+ * scope object created by the loop's dispatch site and passed in the loop's
+ * own call frame; it is verified by object identity against the live scope
+ * and consumed once. Without that exact object this call can consume, mint or
+ * reset nothing and returns false; a dispatch authorised this way still
+ * passes the Host middleware's read-only verification.
+ */
+export function admitLoopDispatchOrigin(capability: unknown): boolean {
+  const origin = dispatchOrigin.getStore()
+  if (origin === undefined || origin !== capability || origin.admitted) return false
+  origin.admitted = true
+  return true
+}
+
+/**
+ * Clear-only isolation runner: the callback runs with no loop dispatch origin
+ * visible. It can never establish, restore or mint an origin. dsh-llm's
+ * admission uses it so public dispatches initiated inside a live scope do not
+ * inherit the outer origin.
+ */
+export function runOutsideLoopDispatchOrigin<T>(fn: () => T): T {
+  return dispatchOrigin.run(undefined, fn)
+}

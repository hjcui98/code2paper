{
  "schema_version": "2.0",
  "mode": "intent-obligation-graph-v2",
  "project_goal": "Develop a retrieval-augmented generation system that efficiently handles complex, multi-hop queries over large-scale unstructured corpora by eliminating reliance on error-prone relation extraction, using only entity-based graph indexing and a two-stage retrieval mechanism.",
  "method_goal": "Demonstrate that a relation-free hierarchical graph (Tri-Graph) with lightweight construction and a two-stage retrieval approach (entity activation via semantic bridging + global importance aggregation via PageRank) can outperform graph-based RAG methods while achieving linear scalability and zero LLM token cost during indexing.",
  "implementation_scope": "",

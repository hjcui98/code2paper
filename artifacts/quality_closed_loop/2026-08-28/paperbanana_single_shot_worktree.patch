+def _parse_page_range(page_range: str) -> tuple[int, int] | None:
+    page_range = str(page_range or "").strip()
+    if not page_range:
+        return None
+
+    match = re.fullmatch(r"(\d+)\s*-\s*(\d+)", page_range)
+    if match:
+        start, end = int(match.group(1)), int(match.group(2))
+        if start > 0 and end >= start:
+            return start, end
+
+    if page_range.isdigit():
+        page = int(page_range)
+        if page > 0:
+            return page, page
+
+    raise ValueError(f"Invalid page range: {page_range!r}. Use formats like '1-12' or '3'.")
+
+
+def load_pdf_text(pdf_path: str, page_range: str) -> str:
+    pdf_path = str(pdf_path)
+    page_bounds = _parse_page_range(page_range)
+    cmd = ["pdftotext", "-enc", "UTF-8"]
+    if page_bounds:
+        cmd.extend(["-f", str(page_bounds[0]), "-l", str(page_bounds[1])])
+    cmd.extend([pdf_path, "-"])
+    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
+    if proc.returncode != 0:
+        raise RuntimeError(proc.stderr.strip() or f"pdftotext failed with exit code {proc.returncode}")
+    return proc.stdout
+
+
+def extract_method_section(text: str) -> str:
+    normalized = str(text or "").replace("\r\n", "\n")
+    block_start_match = re.search(
+        r"(?:\n| {4,})(\d+\.\s+[^\n]{0,120}(?:proposed method|method(?:ology)?|approach|framework|architecture)[^\n]{0,120})",
+        normalized,
+        flags=re.IGNORECASE,
+    )
+    if block_start_match:
+        start_idx = block_start_match.start(1)
+        tail = normalized[start_idx:]
+        block_end_match = re.search(
+            r"(?:\n| {4,})(\d+\.\s+[^\n]{0,120}(?:experiments?|evaluation|results?|discussion|conclusion|references|appendix)[^\n]{0,120})",
+            tail,
+            flags=re.IGNORECASE,
+        )
+        if block_end_match and block_end_match.start(1) > 0:
+            tail = tail[:block_end_match.start(1)]
+        cleaned = tail.strip()
+        if cleaned:
+            return cleaned[:40000]
+
+    lines = normalized.splitlines()
+    top_level_heading_re = re.compile(r"^\s*(\d+)\.\s+(.{3,120})$")
+    headings: list[tuple[int, int, str]] = []
+
+    for idx, line in enumerate(lines):
+        match = top_level_heading_re.match(line.strip())
+        if not match:
+            continue
+        section_num = int(match.group(1))
+        section_title = " ".join(match.group(2).split())
+        headings.append((idx, section_num, section_title))
+
+    if headings:
+        positive_keywords = (
+            "method",
+            "methodology",
+            "approach",
+            "framework",
+            "architecture",
+            "proposed method",
+            "proposed approach",
+            "our method",
+        )
+        negative_keywords = (
+            "introduction",
+            "related work",
+            "background",
+            "preliminary",
+            "preliminaries",
+            "abstract",
+            "experiments",
+            "evaluation",
+            "results",
+            "discussion",
+            "conclusion",
+            "references",
+            "appendix",
+        )
+
+        chosen_idx = None
+        for idx, _section_num, title in headings:
+            lowered = title.lower()
+            if any(keyword in lowered for keyword in positive_keywords):
+                chosen_idx = idx
+                break
+
+        if chosen_idx is None:
+            experiment_idx = None
+            for idx, _section_num, title in headings:
+                lowered = title.lower()
+                if any(keyword in lowered for keyword in ("experiments", "evaluation", "results")):
+                    experiment_idx = idx
+                    break
+
+            candidate_sections = []
+            for idx, section_num, title in headings:
+                lowered = title.lower()
+                if any(keyword in lowered for keyword in negative_keywords):
+                    continue
+                if section_num >= 2 and (experiment_idx is None or idx < experiment_idx):
+                    candidate_sections.append(idx)
+
+            if candidate_sections:
+                chosen_idx = candidate_sections[-1]
+
+        if chosen_idx is not None:
+            end_idx = len(lines)
+            for idx, _section_num, _title in headings:
+                if idx > chosen_idx:
+                    end_idx = idx
+                    break
+            section_text = "\n".join(lines[chosen_idx:end_idx]).strip()
+            if section_text:
+                return section_text[:40000]
+
+    fallback_match = re.search(
+        r"^\s*(?:\d+(?:\.\d+)*)?\s*(method(?:ology)?|approach|framework|architecture)\b",
+        normalized,
+        flags=re.IGNORECASE | re.MULTILINE,
+    )
+    if fallback_match:
+        tail = normalized[fallback_match.start():]
+        end_match = re.search(
+            r"^\s*(?:\d+(?:\.\d+)*)?\s*(experiments?|evaluation|results?|discussion|conclusion|related work|references|appendix)\b",
+            tail,
+            flags=re.IGNORECASE | re.MULTILINE,
+        )
+        if end_match and end_match.start() > 0:
+            tail = tail[:end_match.start()]
+        return tail.strip()[:40000]
+
+    return normalized.strip()[:40000]
+
+
+def infer_title_from_text(text: str) -> str:
+    lines = [line.strip() for line in str(text or "").splitlines() if line.strip()]
+    for line in lines[:20]:
+        if len(line) >= 12 and "@" not in line and len(line.split()) >= 3:
+            return " ".join(line.split())[:160]
+    return ""
+
+
+def infer_caption(content: str, title: str = "") -> str:
+    title = " ".join(str(title or "").split())
+    if title:
+        return f"Overview of the proposed method in {title}"
+    if "3d" in content.lower():
+        return "Overview of the proposed 3D perception pipeline"
+    return "Overview of the proposed method"

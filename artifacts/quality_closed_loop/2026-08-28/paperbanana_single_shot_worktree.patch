+def _extract_b64_from_data_url(value: str) -> str | None:
+    if isinstance(value, str) and value.startswith("data:image") and "," in value:
+        return value.split(",", 1)[1]
+    return None
+
+
+def _extract_base64_image_payload(obj: Any) -> str | None:
+    if isinstance(obj, str):
+        return _extract_b64_from_data_url(obj)
+
+    if isinstance(obj, list):
+        for item in obj:
+            found = _extract_base64_image_payload(item)
+            if found:
+                return found
+        return None
+
+    if not isinstance(obj, dict):
+        return None
+
+    inline_data = obj.get("inline_data")
+    if isinstance(inline_data, dict):
+        b64_data = inline_data.get("data")
+        if isinstance(b64_data, str) and b64_data:
+            return b64_data
+
+    for key in ("b64_json", "b64", "base64", "image_base64", "data"):
+        value = obj.get(key)
+        if isinstance(value, str) and value:
+            if key == "data" and value.startswith("data:image"):
+                return _extract_b64_from_data_url(value)
+            if key != "data" or not value.startswith("http"):
+                return value
+
+    image_url = obj.get("image_url")
+    if isinstance(image_url, dict):
+        value = image_url.get("url")
+        found = _extract_b64_from_data_url(value)
+        if found:
+            return found
+    elif isinstance(image_url, str):
+        found = _extract_b64_from_data_url(image_url)
+        if found:
+            return found
+
+    for key in ("content", "multi_mod_content", "images", "message", "choices"):
+        if key in obj:
+            found = _extract_base64_image_payload(obj[key])
+            if found:
+                return found
+
+    for value in obj.values():
+        found = _extract_base64_image_payload(value)
+        if found:
+            return found
+
+    return None
+
+
+def _extract_image_url_payload(obj: Any) -> str | None:
+    if isinstance(obj, str):
+        return obj if obj.startswith(("http://", "https://")) else None
+
+    if isinstance(obj, list):
+        for item in obj:
+            found = _extract_image_url_payload(item)
+            if found:
+                return found
+        return None
+
+    if not isinstance(obj, dict):
+        return None
+
+    for key in ("url", "image_url"):
+        value = obj.get(key)
+        if isinstance(value, str) and value.startswith(("http://", "https://")):
+            return value
+        if isinstance(value, dict):
+            nested = value.get("url")
+            if isinstance(nested, str) and nested.startswith(("http://", "https://")):
+                return nested
+
+    for key in ("data", "images", "content", "multi_mod_content", "message", "choices"):
+        if key in obj:
+            found = _extract_image_url_payload(obj[key])
+            if found:
+                return found
+
+    for value in obj.values():
+        found = _extract_image_url_payload(value)
+        if found:
+            return found
+
+    return None
+
+
+def _is_aihubmix_size_not_supported_error(exc: httpx.HTTPStatusError) -> bool:
+    response = getattr(exc, "response", None)
+    if response is None or response.status_code != 400:
+        return False
+    error_text = response.text.lower()
+    return "size_not_supported" in error_text or "size not supported" in error_text
+
+
+async def _download_image_url_as_base64(url: str, headers: dict[str, str] | None = None) -> str | None:
+    if not url:
+        return None
+    request_headers = {}
+    if headers and "Authorization" in headers:
+        request_headers["Authorization"] = headers["Authorization"]
+    try:
+        async with httpx.AsyncClient(timeout=300, follow_redirects=True) as client:
+            resp = await client.get(url, headers=request_headers)
+        resp.raise_for_status()
+        if not resp.content:
+            return None
+        return base64.b64encode(resp.content).decode("utf-8")
+    except Exception as exc:
+        print(f"[Warning]: Failed to download generated image URL: {exc}")
+        return None
+

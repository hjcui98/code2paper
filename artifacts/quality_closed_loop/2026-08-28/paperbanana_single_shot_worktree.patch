+def resolve_model_provider(model_name: str) -> tuple[str, str]:
+    """
+    Resolve provider and the concrete model id to use.
+    """
+    if model_name.startswith("openrouter/"):
+        return "openrouter", model_name[len("openrouter/"):]
+    if model_name.startswith("aihubmix/"):
+        return "aihubmix", model_name[len("aihubmix/"):]
+    if _is_openai_image_model(model_name):
+        if aihubmix_client is not None:
+            return "aihubmix", model_name
+        if openai_client is not None:
+            return "openai", model_name
+    if model_name.startswith("claude-"):
+        return "anthropic", model_name
+    if any(model_name.startswith(p) for p in ("gpt-", "o1-", "o3-", "o4-", "qwen")):
+        if openai_client is not None:
+            return "openai", model_name
+        if aihubmix_client is not None:
+            return "aihubmix", model_name
+        if openrouter_client is not None:
+            return "openrouter", _to_openrouter_model_id(model_name)
+        return "openai", model_name
+
+    actual_model = model_name
+    if openrouter_client is not None:
+        return "openrouter", _to_openrouter_model_id(model_name)
+    if aihubmix_client is not None:
+        return "aihubmix", actual_model
+    if gemini_client is not None:
+        return "gemini", actual_model
+    if anthropic_client is not None:
+        return "anthropic", actual_model
+    if openai_client is not None:
